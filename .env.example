# Copy to .env.local for local development. Set the same keys in Vercel
# (Project → Settings → Environment Variables). Never commit real values.

# Canonical site URL used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.seedu.io

# Public contact address (not published on the current site — confirm before launch).
NEXT_PUBLIC_CONTACT_EMAIL=hello@seedu.io

# Show "Pending approval" badges on unverified claims. Set to false once every
# item in CONTENT_APPROVALS.md is approved or removed.
NEXT_PUBLIC_SHOW_APPROVAL_MARKERS=true

# Optional: real SEED U "Ask" endpoint. When unset, the demo uses local sample answers.
# Contract: POST { question, language } -> AskAnswer JSON (see src/lib/ask/types.ts).
NEXT_PUBLIC_SEEDU_ASK_ENDPOINT=

# Optional: Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Unset = no analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional: Google Search Console HTML-tag verification token.
NEXT_PUBLIC_GSC_VERIFICATION=
